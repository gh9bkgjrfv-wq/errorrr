-- SELECT QUERIES SAHA ANITH COMMANDS


-- i. Hama event ekakatama wikunapu total tickets ganana pennanna
SELECT E.EventID, E.EventName, COUNT(T.TicketID) AS TotalTicketsSold
FROM Events E
LEFT JOIN Tickets T ON E.EventID = T.EventID
GROUP BY E.EventID, E.EventName;

-- ii. Hama event ekakama average ticket price eka hoyanna
SELECT E.EventID, E.EventName, AVG(T.TicketPrice) AS AverageTicketPrice
FROM Events E
LEFT JOIN Tickets T ON E.EventID = T.EventID
GROUP BY E.EventID, E.EventName;

-- iii. Venas (Distinct) Event types tika pennanna
SELECT DISTINCT EventType 
FROM Events;

-- iv. 'N' akuren patan ganna Attendees lava hoyanna
SELECT * FROM Attendees 
WHERE AttendeeName LIKE 'N%';

-- v. Confirmed status thiyena attendees la 1 ta wada inna events hoyanna
SELECT E.EventID, E.EventName, COUNT(T.TicketID) AS ConfirmedAttendeesCount
FROM Events E
JOIN Tickets T ON E.EventID = T.EventID
WHERE T.Status = 'Confirmed'
GROUP BY E.EventID, E.EventName
HAVING COUNT(T.TicketID) > 1;

-- vi. Tickets table eke structure eka balanna
DESCRIBE Tickets;

-- vii. TicketPrice eka wadi ma idala adu ma ekata (DESC) arrange karala top 3 pennanna
SELECT EventName, TicketPrice
FROM Events
JOIN Tickets ON Events.EventID = Tickets.EventID
ORDER BY TicketPrice DESC
LIMIT 3;

