-- 1. Database eka hadanawa saha eka use karanawa
CREATE DATABASE bank;
USE bank;

-- 2. BRANCH Table eka hadanawa
CREATE TABLE BRANCH (
    Branch_ID INT PRIMARY KEY,
    Location VARCHAR(100)
);

-- 3. CUSTOMER Table eka hadanawa
CREATE TABLE CUSTOMER (
    Cust_Id INT PRIMARY KEY,
    Name VARCHAR(100),
    Address VARCHAR(255)
);

-- 4. ACCOUNT Table eka hadanawa
CREATE TABLE ACCOUNT (
    Acc_Id BIGINT PRIMARY KEY,
    Acc_Type VARCHAR(50),
    Acc_Balance DECIMAL(12,2),
    Cust_Id INT,
    Branch_Id INT,
    FOREIGN KEY (Cust_Id) REFERENCES CUSTOMER(Cust_Id),
    FOREIGN KEY (Branch_Id) REFERENCES BRANCH(Branch_ID)
);

-- 5. Venues Table eka hadanawa
CREATE TABLE Venues (
    VenueID INT PRIMARY KEY,
    VenueName VARCHAR(100),
    City VARCHAR(100),
    Capacity INT
);

-- 6. Events Table eka hadanawa
CREATE TABLE Events (
    EventID INT PRIMARY KEY,
    EventName VARCHAR(100),
    EventType VARCHAR(50),
    VenueID INT,
    FOREIGN KEY (VenueID) REFERENCES Venues(VenueID)
);

-- 7. Tickets Table eka hadanawa (passe ALTER command eka wada karanna kalin 'Price' widihata damma)
CREATE TABLE Tickets (
    TicketID INT PRIMARY KEY,
    EventID INT,
    Price DECIMAL(10,2),
    Status VARCHAR(50),
    FOREIGN KEY (EventID) REFERENCES Events(EventID)
);

-- 8. Attendees Table eka hadanawa
CREATE TABLE Attendees (
    AttendeeID INT PRIMARY KEY,
    AttendeeName VARCHAR(100)
);


