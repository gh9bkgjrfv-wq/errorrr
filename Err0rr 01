FROM PATIENT p
JOIN APPOINTMENT a ON p.patientno = a.patientno
JOIN TREATMENT t ON a.appointmentno = t.appointmentno
WHERE t.cost > 50000;

SELECT DISTINCT p.pname 
FROM PATIENT p
JOIN ADMISSION ad ON p.patientno = ad.patientno
JOIN WARD w ON ad.wardno = w.wardno
WHERE p.city = w.city;

SELECT COUNT(*) AS No_Of_Wards 
FROM WARD 
WHERE city = 'Colombo';

SELECT admissionno, admission_date, discharge_date 
FROM ADMISSION 
WHERE discharge_date >= admission_date;

