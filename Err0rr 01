CREATE DATABASE hospital_db;
USE hospital_db;

CREATE TABLE PATIENT (
    patientno INT PRIMARY KEY,
    pname VARCHAR(50),
    city VARCHAR(50),
    phone VARCHAR(15)
);

CREATE TABLE DOCTOR (
    doctorno INT PRIMARY KEY,
    dname VARCHAR(50),
    specialization VARCHAR(50)
);

CREATE TABLE WARD (
    wardno INT PRIMARY KEY,
    wardname VARCHAR(50),
    city VARCHAR(50)
);

CREATE TABLE ADMISSION (
    admissionno INT PRIMARY KEY,
    patientno INT,
    wardno INT,
    admission_date DATE,
    discharge_date DATE
);

CREATE TABLE APPOINTMENT (
    appointmentno INT PRIMARY KEY,
    appointment_date DATE,
    patientno INT,
    doctorno INT
);

CREATE TABLE TREATMENT (
    treatmentno INT PRIMARY KEY,
    appointmentno INT,
    description VARCHAR(100),
    cost INT
);

ALTER TABLE ADMISSION ADD CONSTRAINT fk_pat FOREIGN KEY (patientno) REFERENCES PATIENT(patientno);
ALTER TABLE ADMISSION ADD CONSTRAINT fk_ward FOREIGN KEY (wardno) REFERENCES WARD(wardno);

ALTER TABLE APPOINTMENT ADD CONSTRAINT fk_appt_pat FOREIGN KEY (patientno) REFERENCES PATIENT(patientno);
ALTER TABLE APPOINTMENT ADD CONSTRAINT fk_appt_doc FOREIGN KEY (doctorno) REFERENCES DOCTOR(doctorno);

ALTER TABLE TREATMENT ADD CONSTRAINT fk_treat_appt FOREIGN KEY (appointmentno) REFERENCES APPOINTMENT(appointmentno);

DESCRIBE PATIENT;
DESCRIBE DOCTOR;
DESCRIBE WARD;
DESCRIBE ADMISSION;
DESCRIBE APPOINTMENT;
DESCRIBE TREATMENT;

